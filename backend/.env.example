# Copy this file to ".env" and fill in your own values. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string. Leave empty to run with in-memory storage (demo mode, data resets on restart).
MONGODB_URI=

# Secret used to sign JWT access tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Origin of the React frontend (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Real e-mail through Gmail SMTP (Adapter pattern). Leave SMTP_USER empty to simulate e-mail in the console.
# SMTP_PASS must be a Gmail "App password" (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Demo users have fake @itsm.demo addresses, so redirect every real e-mail to this inbox.
EMAIL_OVERRIDE_RECIPIENT=

# How often the background SLA monitor runs (milliseconds)
SLA_MONITOR_INTERVAL_MS=30000
